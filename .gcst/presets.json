{
    ".vars": {
        "C++_VERSION": "23",
        "CMAKE_GENERATOR": "Ninja",
        "CMAKE_GENERATOR_RSRV": "NMake Makefiles",
        "GCC_VERSION": {
            "local": "16.1.0",
            "github_ci": "16.1.0"
        },
        "CLANG_VERSION": {
            "local": "19.1.7",
            "github_ci": "19.1.7"
        },
        "MSVC_VERSION": {
            "local": "19.44",
            "github_ci": "19.44"
        },
        "MSVC_RUNTIME_VERSION": {
            "local": "14.44",
            "github_ci": "14.44"
        }
    },

    ".common-pre": [
        {
            "uses": "actions/setup-python@v5",
            "with": {
                "python-version": "3.12"
            }
        },
        {
            "run": "pip install conan ruamel.yaml"
        },
        {
            "uses": "actions/checkout@v4"
        },
        {
            "run": "conan profile detect --force"
        },
        {
            "run": "python .gcst/scripts/configure.py"
        },
        {
            "run": "git diff --exit-code .github/workflows/ci.yml"
        },
        {
            "name": "Restore Conan cache",
            "id": "conan-cache",
            "uses": "actions/cache/restore@v4",
            "with": {
                "path": "conan-cache.tgz",
                "key": "conan2-${{ matrix.preset }}-${{ github.run_id }}",
                "restore-keys": "conan2-${{ matrix.preset }}-"
            }
        },
        {
            "name": "Unpack Conan cache",
            "if": "steps.conan-cache.outputs.cache-matched-key != ''",
            "run": "conan cache restore conan-cache.tgz"
        }
    ],

    ".common-post": [
        {
            "name": "Log results",
            "if": "always()",
            "shell": "bash",
            "run": "echo \"${{ matrix.preset }} ${{ job.status }}\" > r-${{ matrix.preset }}.txt"
        },
        {
            "uses": "actions/upload-artifact@v4",
            "if": "always()",
            "with": {
                "name": "ci-result-${{ matrix.preset }}",
                "path": "r-${{ matrix.preset }}.txt"
            }
        },
        {
            "name": "Check Conan cache freshness",
            "id": "conan-fresh",
            "if": "!cancelled() && hashFiles('build/conan_toolchain.cmake') != ''",
            "run": "python .gcst/scripts/conan_cache_fresh.py build/graph.json"
        },
        {
            "name": "Pack Conan cache",
            "if": "!cancelled() && steps.conan-fresh.outputs.save == 'true'",
            "run": "conan list --graph=build/graph.json --format=json --out-file=pkglist.json && conan cache save --list=pkglist.json --file=conan-cache.tgz"
        },
        {
            "name": "Save Conan cache",
            "if": "!cancelled() && steps.conan-fresh.outputs.save == 'true'",
            "uses": "actions/cache/save@v4",
            "with": {
                "path": "conan-cache.tgz",
                "key": "${{ steps.conan-cache.outputs.cache-primary-key }}"
            }
        }
    ],

    "unix-clang-libc++": {
        "cmake": {
            "description": "Clang + LLVM libc++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Linux",
                "arch": "x86_64",
                "compiler": "clang",
                "compiler.libcxx": "libc++",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
                "tools.build:exelinkflags": "[\"-fuse-ld=lld\"]",
                "tools.build:sharedlinkflags": "[\"-fuse-ld=lld\"]",
                "tools.build:compiler_executables": "{\"c\": \"clang\", \"cpp\": \"clang++\"}"
            }
        },
        "github_ci": [
            {
                "run-files": ["clang.sh"]
            }
        ]
    },
    
    "unix-clang-libstdc++": {
        "cmake": {
            "description": "Clang + GCC libstdc++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Linux",
                "arch": "x86_64",
                "compiler": "clang",
                "compiler.libcxx": "libstdc++11",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
                "tools.build:exelinkflags": "[\"-fuse-ld=lld\"]",
                "tools.build:sharedlinkflags": "[\"-fuse-ld=lld\"]",
                "tools.build:compiler_executables": "{\"c\": \"clang\", \"cpp\": \"clang++\"}"
            }
        },
        "github_ci": [
            {
                "run-files": ["clang.sh", "gcc.sh"]
            }
        ]
    },

    "unix-gcc-libstdc++": {
        "cmake": {
            "description": "GNU C Compiler for Unix Makefiles",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Linux",
                "arch": "x86_64",
                "compiler": "gcc",
                "compiler.libcxx": "libstdc++11",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            }
        },
        "github_ci": [
            {
                "run-files": ["gcc.sh"]
            }
        ]
    },

    "win64-clang-libc++": {
        "cmake": {
            "description": "Clang + libc++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Windows",
                "arch": "x86_64",
                "compiler": "clang",
                "compiler.libcxx": "libc++",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
                "tools.build:cflags": "[\"--target=x86_64-w64-mingw32\"]",
                "tools.build:cxxflags": "[\"--target=x86_64-w64-mingw32\"]",
                "tools.build:exelinkflags": "[\"-fuse-ld=lld\", \"--target=x86_64-w64-mingw32\"]",
                "tools.build:sharedlinkflags": "[\"-fuse-ld=lld\", \"--target=x86_64-w64-mingw32\"]",
                "tools.build:compiler_executables": "{\"c\": \"clang\", \"cpp\": \"clang++\"}"
            }
        },
        "github_ci": [
            {
                "run-files": ["clang-mingw.ps1"],
                "shell": "pwsh"
            }
        ]
    },
    
    "win64-clang-libstdc++": {
        "cmake": {
            "description": "Clang + MinGW libstdc++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Windows",
                "arch": "x86_64",
                "compiler": "clang",
                "compiler.libcxx": "libstdc++11",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
                "tools.build:cflags": "[\"--target=x86_64-w64-mingw32\"]",
                "tools.build:cxxflags": "[\"--target=x86_64-w64-mingw32\"]",
                "tools.build:exelinkflags": "[\"-fuse-ld=lld\", \"--target=x86_64-w64-mingw32\", \"-pthread\"]",
                "tools.build:sharedlinkflags": "[\"-fuse-ld=lld\", \"--target=x86_64-w64-mingw32\", \"-pthread\"]",
                "tools.build:compiler_executables": "{\"c\": \"clang\", \"cpp\": \"clang++\"}"
            }
        },
        "github_ci": [
            {
                "run-files": ["clang-msvc.ps1", "gcc.ps1"],
                "shell": "pwsh"
            }
        ]
    },
    
    "win64-clang-msvc": {
        "cmake": {
            "description": "Clang + MSVC++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Windows",
                "arch": "x86_64",
                "compiler": "clang",
                "compiler.runtime": "dynamic",
                "compiler.runtime_type": "Release",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            }
        },
        "github_ci": [
            {
                "uses": "ilammy/msvc-dev-cmd@v1",
                "with": {
                    "toolset": "{gcst::MSVC_RUNTIME_GITHUB_CI_FULL_VERSION}"
                }
            },
            {
                "run-files": ["clang-msvc.ps1"]
            }
        ]
    },
    
    "win64-gcc-libstdc++": {
        "cmake": {
            "description": "MinGW32",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Windows",
                "arch": "x86_64",
                "compiler": "gcc",
                "compiler.libcxx": "libstdc++11",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
                "tools.build:compiler_executables": "{\"c\": \"x86_64-w64-mingw32-gcc\", \"cpp\": \"x86_64-w64-mingw32-g++\"}"
            }
        },
        "github_ci": [
            {
                "run-files": ["gcc.ps1"],
                "shell": "pwsh"
            }
        ]
    },
    
    "win64-msvc-msvcstl": {
        "cmake": {
            "description": "MSVC++",
            "generator": "{gcst::CMAKE_GENERATOR}",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "{gcst::C++_VERSION}",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        "conan": {
            "settings": {
                "os": "Windows",
                "arch": "x86_64",
                "compiler": "msvc",
                "compiler.runtime": "dynamic",
                "compiler.runtime_type": "Release",
                "compiler.cppstd": "{gcst::C++_VERSION}",
                "build_type": "Release"
            },
            "conf": {
